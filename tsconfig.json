{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2023",
    "lib": ["ES2023"],
    "outDir": "dist",
    "rootDir": "src",
    "typeRoots": ["node_modules/@coral-xyz/anchor/types", "node_modules/@types", "@types"],
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "downlevelIteration": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "useUnknownInCatchVariables": false,
    "strict": true
  },
  "compileOnSave": true,
  "include": ["src/**/*"],
  "exclude": ["dist", "tests", "node_modules"]
}
